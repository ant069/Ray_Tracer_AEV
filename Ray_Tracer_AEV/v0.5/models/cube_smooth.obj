# Cube OBJ with smoothing groups for v0.5 Phong shading demo
# Each face pair (quad) gets its own smoothing group so hard edges
# between faces are preserved (matching slide 10 behaviour).

o Cube

v -0.5000 0.0000  0.5000
v -0.5000 0.0000 -0.5000
v  0.5000 0.0000 -0.5000
v  0.5000 0.0000  0.5000
v -0.5000 1.0000  0.5000
v  0.5000 1.0000  0.5000
v  0.5000 1.0000 -0.5000
v -0.5000 1.0000 -0.5000

vn  0.0000 -1.0000  0.0000
vn  0.0000  1.0000  0.0000
vn  0.0000  0.0000  1.0000
vn  1.0000  0.0000  0.0000
vn  0.0000  0.0000 -1.0000
vn -1.0000  0.0000  0.0000

# Bottom face – smoothing group 1
s 1
f 1//1 2//1 3//1
f 3//1 4//1 1//1

# Top face – smoothing group 2
s 2
f 5//2 6//2 7//2
f 7//2 8//2 5//2

# Front face – smoothing group 3
s 3
f 1//3 4//3 6//3
f 6//3 5//3 1//3

# Right face – smoothing group 4
s 4
f 4//4 3//4 7//4
f 7//4 6//4 4//4

# Back face – smoothing group 5
s 5
f 3//5 2//5 8//5
f 8//5 7//5 3//5

# Left face – smoothing group 6
s 6
f 2//6 1//6 5//6
f 5//6 8//6 2//6
